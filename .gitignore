# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# review-auto local data (JSON store, cached style profile, history)
/data/

# playwright persistent browser profile (naver login session)
/.naver-session/

# playwright test artifacts
/test-results/
/playwright-report/

# temp resized images for vision analysis
/temp/

# superpowers SDD workspace (scratch, not part of the record)
/.superpowers/
